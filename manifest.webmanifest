{
  "id": "/",
  "name": "AKD Image",
  "short_name": "AKD Image",
  "description": "Бесплатные инструменты для локальной обработки изображений в браузере.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#111318",
  "theme_color": "#191C20",
  "categories": ["photo", "graphics", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Сжать изображение",
      "short_name": "Сжатие",
      "url": "/compress?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Изменить размер",
      "short_name": "Размер",
      "url": "/resize?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Конвертировать",
      "short_name": "Конвертация",
      "url": "/convert?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
